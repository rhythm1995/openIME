{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "openIME",
  "version": "0.2.0",
  "identifier": "com.openime.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "openIME",
        "width": 1200,
        "height": 800,
        "minWidth": 880,
        "minHeight": 600,
        "resizable": true,
        "visible": false,
        "hiddenTitle": true,
        "titleBarStyle": "Overlay",
        "theme": "Dark"
      },
      {
        "label": "overlay",
        "title": "",
        "width": 220,
        "height": 40,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "visible": false,
        "focus": false,
        "focusable": false,
        "x": 16,
        "y": 99999,
        "url": "index.html#overlay"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "resources": [
      "ime/OpenImeTsf.dll"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "macOS": {
      "minimumSystemVersion": "12.0",
      "hardenedRuntime": false,
      "signingIdentity": "openIME Local Dev"
    },
    "windows": {
      "nsis": {
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFFMTMyQzRDMjkyOUQ4MTUKUldRVjJDa3BUQ3dUcm9jS2R1c1o1Tm1oUVIvSGFiY1UrQ1g2eE9BYitkM29KN3Q0NFV3TGlDeEQK",
      "endpoints": [
        "https://github.com/rhythm1995/openIME/releases/latest/download/latest.json"
      ]
    }
  }
}

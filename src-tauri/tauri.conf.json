{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "openIME",
  "version": "0.1.0",
  "identifier": "com.openime.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "openIME",
        "width": 1200,
        "height": 800,
        "minWidth": 880,
        "minHeight": 600,
        "resizable": true,
        "visible": false,
        "hiddenTitle": true,
        "titleBarStyle": "Overlay"
      },
      {
        "label": "overlay",
        "title": "",
        "width": 220,
        "height": 40,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "visible": false,
        "focus": false,
        "focusable": false,
        "x": 16,
        "y": 99999,
        "url": "index.html#overlay"
      },
      {
        "label": "qa",
        "title": "openIME 问答",
        "width": 400,
        "height": 520,
        "resizable": true,
        "decorations": true,
        "alwaysOnTop": true,
        "skipTaskbar": false,
        "shadow": true,
        "visible": false,
        "focus": false,
        "url": "index.html#qa"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "macOS": {
      "minimumSystemVersion": "12.0",
      "hardenedRuntime": false,
      "signingIdentity": "openIME Local Dev"
    }
  }
}
